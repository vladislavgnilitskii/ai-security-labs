LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_API_KEY=local
LOCAL_MODEL=qwen2.5:1.5b

CLOUD_BASE_URL=https://openrouter.ai/api/v1
CLOUD_API_KEY=your_openrouter_key_here
CLOUD_MODEL=liquid/lfm-2.5-2.6b:free

# Опционально: SOCKS5-прокси для облачного клиента, если провайдер
# блокирует запросы с вашего IP (см. README, раздел "Сетевое ограничение").
# Оставьте пустым, если прямое подключение работает.
CLOUD_HTTP_PROXY=
